# Application
NODE_ENV=development
APP_NAME=Sunset ERP
APP_VERSION=0.0.0

# Database
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/sunset_erp
DATABASE_TEST_URL=postgresql://erp:erp_test_password@localhost:5433/sunset_erp_test

# API
API_PORT=3000
API_HOST=0.0.0.0

# Web
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Worker
WORKER_PORT=3002

# Auth
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Seed
SEED_ADMIN_PASSWORD=change-me-in-dev

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Correlation
CORRELATION_ID_HEADER=x-correlation-id
