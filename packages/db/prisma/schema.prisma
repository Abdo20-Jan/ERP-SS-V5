// Sunset ERP Database Schema
// MS-00-SS2: DB + API + Health

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTIDADE E RBAC
// ============================================

model User {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles UserRole[]
  audit AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  action      String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// AUDITORIA APPEND-ONLY
// ============================================

model AuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// PARÂMETROS COM VIGÊNCIA
// ============================================

model Parameter {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String
  value       Json
  description String?
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, validFrom])
  @@index([key, validFrom, validUntil])
  @@map("parameters")
}

// ============================================
// PARTY MDM (MS-01-SS2)
// ============================================

model Party {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @default("org_001") @map("organization_id")
  partyType      String   @map("party_type")
  legalName      String   @map("legal_name")
  tradeName      String?  @map("trade_name")
  roles          String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  documents PartyDocument[]
  addresses PartyAddress[]
  contacts  PartyContact[]
  fiscal    FiscalClassification?

  @@index([organizationId])
  @@index([legalName])
  @@index([isActive])
  @@map("parties")
}

model PartyDocument {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId     String    @map("party_id") @db.Uuid
  type        String
  value       String
  isPrimary   Boolean   @default(false) @map("is_primary")
  validatedAt DateTime? @map("validated_at") @db.Timestamptz
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([partyId])
  @@map("party_documents")
}

model PartyAddress {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId      String  @map("party_id") @db.Uuid
  type         String
  street       String
  streetNumber String  @map("street_number")
  complement   String?
  neighborhood String?
  city         String
  province     String
  country      String  @default("AR")
  postalCode   String  @map("postal_code")
  isPrimary    Boolean @default(false) @map("is_primary")
  party        Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_addresses")
}

model PartyContact {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId   String  @map("party_id") @db.Uuid
  name      String
  position  String?
  email     String
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_contacts")
}

model FiscalClassification {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId           String    @unique @map("party_id") @db.Uuid
  ivaCondition      String    @map("iva_condition")
  iibbCondition     String?   @map("iibb_condition")
  iibbNumber        String?   @map("iibb_number")
  iibbProvince      String?   @map("iibb_province")
  startOfActivities DateTime? @map("start_of_activities") @db.Date
  party             Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("fiscal_classifications")
}

// ============================================
// PRODUCT MDM (MS-01-SS3)
// ============================================

model ProductCategory {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code      String            @unique
  name      String
  parentId  String?           @map("parent_id") @db.Uuid
  level     Int
  path      String
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String    @default("org_001") @map("organization_id")
  sku             String    @unique
  name            String
  brand           String
  productType     String    @map("product_type")
  description     String?
  categoryId      String?   @map("category_id") @db.Uuid
  ncmCode         String    @map("ncm_code")
  ncmDescription  String?   @map("ncm_description")
  ncmSource       String    @default("MANUAL") @map("ncm_source")
  unitOfMeasure   String    @map("unit_of_measure")
  weight          Decimal?  @db.Decimal(10, 3)
  weightNet       Decimal?  @map("weight_net") @db.Decimal(10, 3)
  weightGross     Decimal?  @map("weight_gross") @db.Decimal(10, 3)
  packagingLength Decimal?  @map("packaging_length") @db.Decimal(8, 2)
  packagingWidth  Decimal?  @map("packaging_width") @db.Decimal(8, 2)
  packagingHeight Decimal?  @map("packaging_height") @db.Decimal(8, 2)
  originCountry   String    @default("AR") @map("origin_country")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category       ProductCategory?       @relation(fields: [categoryId], references: [id])
  tireSpecs      TireSpecification?
  certifications ProductCertification[]

  @@index([organizationId])
  @@index([brand])
  @@index([ncmCode])
  @@index([isActive])
  @@map("products")
}

model TireSpecification {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId   String  @unique @map("product_id") @db.Uuid
  width       Int
  profile     Int
  rimDiameter Decimal @map("rim_diameter") @db.Decimal(5, 2)
  measure     String
  loadIndex   Int?    @map("load_index")
  speedIndex  String? @map("speed_index")
  tireType    String? @map("tire_type")
  season      String?
  dot         String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tire_specifications")
}

model ProductCertification {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  certificateNumber String   @map("certificate_number")
  type              String
  issuingBody       String   @map("issuing_body")
  issueDate         DateTime @map("issue_date") @db.Date
  expiryDate        DateTime @map("expiry_date") @db.Date
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_certifications")
}

// ============================================
// CHART OF ACCOUNTS (MS-01-SS4)
// ============================================

model ChartOfAccounts {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  description String?
  version     Int       @default(1)
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  accounts Account[]

  @@map("chart_of_accounts")
}

model Account {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  coaId              String    @map("coa_id") @db.Uuid
  code               String
  name               String
  type               String
  nature             String
  parentId           String?   @map("parent_id") @db.Uuid
  level              Int
  isSystem           Boolean   @default(false) @map("is_system")
  isActive           Boolean   @default(true) @map("is_active")
  allowManualPosting Boolean   @default(true) @map("allow_manual_posting")
  description        String?
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil         DateTime? @map("valid_until") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  coa      ChartOfAccounts @relation(fields: [coaId], references: [id])
  parent   Account?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]       @relation("AccountHierarchy")

  @@unique([coaId, code])
  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@map("accounts")
}

// ============================================
// CURRENCY & EXCHANGE RATES (MS-01-SS5)
// ============================================

model Currency {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code           String   @unique
  name           String
  symbol         String
  decimalPlaces  Int      @default(2) @map("decimal_places")
  isFunctional   Boolean  @default(false) @map("is_functional")
  isPresentation Boolean  @default(false) @map("is_presentation")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  fromCurrencyId  String    @map("from_currency_id") @db.Uuid
  toCurrencyId    String    @map("to_currency_id") @db.Uuid
  rate            Decimal   @db.Decimal(18, 6)
  validFrom       DateTime  @map("valid_from") @db.Timestamptz
  validUntil      DateTime? @map("valid_until") @db.Timestamptz
  source          String    @default("MANUAL")
  sourceReference String?   @map("source_reference")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, validFrom])
  @@index([validFrom, validUntil])
  @@map("exchange_rates")
}
