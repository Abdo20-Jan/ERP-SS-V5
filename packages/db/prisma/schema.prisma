// Sunset ERP Database Schema
// MS-00-SS2: DB + API + Health

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTIDADE E RBAC
// ============================================

model User {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles           UserRole[]
  audit           AuditLog[]
  entriesCreated  JournalEntry[] @relation("EntryCreatedBy")
  entriesPosted   JournalEntry[] @relation("EntryPostedBy")
  entriesReversed JournalEntry[] @relation("EntryReversedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  action      String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// AUDITORIA APPEND-ONLY
// ============================================

model AuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// PARÂMETROS COM VIGÊNCIA
// ============================================

model Parameter {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String
  value       Json
  description String?
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, validFrom])
  @@index([key, validFrom, validUntil])
  @@map("parameters")
}

// ============================================
// PARTY MDM (MS-01-SS2)
// ============================================

model Party {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @default("org_001") @map("organization_id")
  partyType      String   @map("party_type")
  legalName      String   @map("legal_name")
  tradeName      String?  @map("trade_name")
  roles          String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  documents PartyDocument[]
  addresses PartyAddress[]
  contacts  PartyContact[]
  fiscal    FiscalClassification?

  @@index([organizationId])
  @@index([legalName])
  @@index([isActive])
  @@map("parties")
}

model PartyDocument {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId     String    @map("party_id") @db.Uuid
  type        String
  value       String
  isPrimary   Boolean   @default(false) @map("is_primary")
  validatedAt DateTime? @map("validated_at") @db.Timestamptz
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([partyId])
  @@map("party_documents")
}

model PartyAddress {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId      String  @map("party_id") @db.Uuid
  type         String
  street       String
  streetNumber String  @map("street_number")
  complement   String?
  neighborhood String?
  city         String
  province     String
  country      String  @default("AR")
  postalCode   String  @map("postal_code")
  isPrimary    Boolean @default(false) @map("is_primary")
  party        Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_addresses")
}

model PartyContact {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId   String  @map("party_id") @db.Uuid
  name      String
  position  String?
  email     String
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_contacts")
}

model FiscalClassification {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  partyId           String    @unique @map("party_id") @db.Uuid
  ivaCondition      String    @map("iva_condition")
  iibbCondition     String?   @map("iibb_condition")
  iibbNumber        String?   @map("iibb_number")
  iibbProvince      String?   @map("iibb_province")
  startOfActivities DateTime? @map("start_of_activities") @db.Date
  party             Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("fiscal_classifications")
}

// ============================================
// PRODUCT MDM (MS-01-SS3)
// ============================================

model ProductCategory {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code      String            @unique
  name      String
  parentId  String?           @map("parent_id") @db.Uuid
  level     Int
  path      String
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String    @default("org_001") @map("organization_id")
  sku             String    @unique
  name            String
  brand           String
  productType     String    @map("product_type")
  description     String?
  categoryId      String?   @map("category_id") @db.Uuid
  ncmCode         String    @map("ncm_code")
  ncmDescription  String?   @map("ncm_description")
  ncmSource       String    @default("MANUAL") @map("ncm_source")
  unitOfMeasure   String    @map("unit_of_measure")
  weight          Decimal?  @db.Decimal(10, 3)
  weightNet       Decimal?  @map("weight_net") @db.Decimal(10, 3)
  weightGross     Decimal?  @map("weight_gross") @db.Decimal(10, 3)
  packagingLength Decimal?  @map("packaging_length") @db.Decimal(8, 2)
  packagingWidth  Decimal?  @map("packaging_width") @db.Decimal(8, 2)
  packagingHeight Decimal?  @map("packaging_height") @db.Decimal(8, 2)
  originCountry   String    @default("AR") @map("origin_country")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category       ProductCategory?       @relation(fields: [categoryId], references: [id])
  tireSpecs      TireSpecification?
  certifications ProductCertification[]

  @@index([organizationId])
  @@index([brand])
  @@index([ncmCode])
  @@index([isActive])
  @@map("products")
}

model TireSpecification {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId   String  @unique @map("product_id") @db.Uuid
  width       Int
  profile     Int
  rimDiameter Decimal @map("rim_diameter") @db.Decimal(5, 2)
  measure     String
  loadIndex   Int?    @map("load_index")
  speedIndex  String? @map("speed_index")
  tireType    String? @map("tire_type")
  season      String?
  dot         String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tire_specifications")
}

model ProductCertification {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  certificateNumber String   @map("certificate_number")
  type              String
  issuingBody       String   @map("issuing_body")
  issueDate         DateTime @map("issue_date") @db.Date
  expiryDate        DateTime @map("expiry_date") @db.Date
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_certifications")
}

// ============================================
// CHART OF ACCOUNTS (MS-01-SS4)
// ============================================

model ChartOfAccounts {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  description String?
  version     Int       @default(1)
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  accounts Account[]

  @@map("chart_of_accounts")
}

model Account {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  coaId              String    @map("coa_id") @db.Uuid
  code               String
  name               String
  type               String
  nature             String
  parentId           String?   @map("parent_id") @db.Uuid
  level              Int
  isSystem           Boolean   @default(false) @map("is_system")
  isActive           Boolean   @default(true) @map("is_active")
  allowManualPosting Boolean   @default(true) @map("allow_manual_posting")
  description        String?
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil         DateTime? @map("valid_until") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  coa                   ChartOfAccounts                @relation(fields: [coaId], references: [id])
  parent                Account?                       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children              Account[]                      @relation("AccountHierarchy")
  dimensionRestrictions AccountDimensionRestriction[]
  journalLines          JournalEntryLine[]

  @@unique([coaId, code])
  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@map("accounts")
}

// ============================================
// CURRENCY & EXCHANGE RATES (MS-01-SS5)
// ============================================

model Currency {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code           String   @unique
  name           String
  symbol         String
  decimalPlaces  Int      @default(2) @map("decimal_places")
  isFunctional   Boolean  @default(false) @map("is_functional")
  isPresentation Boolean  @default(false) @map("is_presentation")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  fromCurrencyId  String    @map("from_currency_id") @db.Uuid
  toCurrencyId    String    @map("to_currency_id") @db.Uuid
  rate            Decimal   @db.Decimal(18, 6)
  validFrom       DateTime  @map("valid_from") @db.Timestamptz
  validUntil      DateTime? @map("valid_until") @db.Timestamptz
  source          String    @default("MANUAL")
  sourceReference String?   @map("source_reference")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, validFrom])
  @@index([validFrom, validUntil])
  @@map("exchange_rates")
}

// ============================================
// DIMENSION REGISTRY (MS-01-SS6)
// ============================================

model DimensionDefinition {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type        String
  code        String
  name        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent       DimensionDefinition?          @relation("DimensionHierarchy", fields: [parentId], references: [id])
  children     DimensionDefinition[]         @relation("DimensionHierarchy")
  restrictions AccountDimensionRestriction[]

  @@unique([type, code])
  @@index([parentId])
  @@index([type])
  @@map("dimension_definitions")
}

model AccountDimensionRestriction {
  accountId   String @map("account_id") @db.Uuid
  dimensionId String @map("dimension_id") @db.Uuid
  restriction String

  account   Account             @relation(fields: [accountId], references: [id])
  dimension DimensionDefinition @relation(fields: [dimensionId], references: [id])

  @@id([accountId, dimensionId])
  @@map("account_dimension_restrictions")
}

// ============================================
// LEDGER ENGINE (MS-01-SS7)
// ============================================

model Journal {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code         String   @unique
  name         String
  type         String
  isActive     Boolean  @default(true) @map("is_active")
  nextSequence Int      @default(1) @map("next_sequence")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  entries JournalEntry[]

  @@map("journals")
}

model JournalEntry {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String    @default("org_001") @map("organization_id")
  journalId        String    @map("journal_id") @db.Uuid
  entryNumber      String    @default("") @map("entry_number")
  entryDate        DateTime  @map("entry_date") @db.Date
  description      String
  correlationId    String    @unique @map("correlation_id")
  originModule     String?   @map("origin_module")
  originEntityType String?   @map("origin_entity_type")
  originEntityId   String?   @map("origin_entity_id")
  status           String    @default("DRAFT")
  createdById      String    @map("created_by") @db.Uuid
  postedById       String?   @map("posted_by") @db.Uuid
  postedAt         DateTime? @map("posted_at") @db.Timestamptz
  reversedById     String?   @map("reversed_by") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz
  reversedFromId   String?   @map("reversed_from_id") @db.Uuid
  reversalReason   String?   @map("reversal_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  journal      Journal            @relation(fields: [journalId], references: [id])
  lines        JournalEntryLine[]
  createdBy    User               @relation("EntryCreatedBy", fields: [createdById], references: [id])
  postedBy     User?              @relation("EntryPostedBy", fields: [postedById], references: [id])
  reversedBy   User?              @relation("EntryReversedBy", fields: [reversedById], references: [id])
  reversedFrom JournalEntry?      @relation("ReversalChain", fields: [reversedFromId], references: [id])
  reversals    JournalEntry[]     @relation("ReversalChain")

  @@index([journalId, entryDate])
  @@index([organizationId])
  @@index([originModule, originEntityType, originEntityId])
  @@index([status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  entryId            String   @map("entry_id") @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  debitAmount        Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount       Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  originCurrency     String?  @map("origin_currency")
  originAmount       Decimal? @map("origin_amount") @db.Decimal(18, 2)
  originExchangeRate Decimal? @map("origin_exchange_rate") @db.Decimal(18, 6)
  costCenterId       String?  @map("cost_center_id") @db.Uuid
  projectId          String?  @map("project_id") @db.Uuid
  partyId            String?  @map("party_id") @db.Uuid
  productId          String?  @map("product_id") @db.Uuid
  description        String?
  reference          String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ============================================
// POSTING RULES (MS-01-SS8)
// ============================================

model PostingRule {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name         String
  description  String?
  eventType    String    @map("event_type")
  originModule String    @map("origin_module")
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil   DateTime? @map("valid_until") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid

  lines PostingRuleLine[]

  @@unique([eventType, originModule, validFrom])
  @@index([eventType, originModule, isActive])
  @@map("posting_rules")
}

model PostingRuleLine {
  id                String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ruleId            String  @map("rule_id") @db.Uuid
  sequence          Int
  debitAccountCode  String  @map("debit_account_code")
  creditAccountCode String  @map("credit_account_code")
  condition         String?
  dimensionMapping  Json?   @map("dimension_mapping")
  placeholders      Json?

  rule PostingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sequence])
  @@index([ruleId])
  @@map("posting_rule_lines")
}

// ============================================
// INVENTORY — WAREHOUSES (PR-INVENTORY-01-S01)
// ============================================

model Warehouse {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String   @default("org_001") @map("organization_id")
  code              String
  name              String
  type              String
  addressStreet     String?  @map("address_street")
  addressNumber     String?  @map("address_number")
  addressCity       String?  @map("address_city")
  addressProvince   String?  @map("address_province")
  addressCountry    String   @default("AR") @map("address_country")
  addressPostalCode String?  @map("address_postal_code")
  zones             String[] @default([])
  capacity          Decimal? @db.Decimal(14, 2)
  capacityUnit      String?  @map("capacity_unit")
  isActive          Boolean  @default(true) @map("is_active")
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  locationConfig WarehouseLocationConfig?
  locations      WarehouseLocation[]
  documents      InventoryDocument[]
  tasks          InventoryTask[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@index([isActive])
  @@map("warehouses")
}



// ============================================
// INVENTORY — WAREHOUSE LOCATIONS (PR-INVENTORY-01-S02)
// ============================================

model WarehouseLocationConfig {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  warehouseId  String   @unique @map("warehouse_id") @db.Uuid
  maxLevels    Int      @default(1) @map("max_levels")
  level1Name   String   @default("Zona") @map("level1_name")
  level2Name   String   @default("Rua") @map("level2_name")
  level3Name   String   @default("Rack") @map("level3_name")
  level4Name   String   @default("Nível") @map("level4_name")
  level5Name   String   @default("Posição") @map("level5_name")
  useLevel2    Boolean  @default(false) @map("use_level2")
  useLevel3    Boolean  @default(false) @map("use_level3")
  useLevel4    Boolean  @default(false) @map("use_level4")
  useLevel5    Boolean  @default(false) @map("use_level5")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@map("warehouse_location_configs")
}

model WarehouseLocation {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  parentKey    String   @map("parent_key")
  level        Int
  code         String
  name         String
  path         String
  isVirtual    Boolean  @default(false) @map("is_virtual")
  virtualType  String?  @map("virtual_type")
  isActive     Boolean  @default(true) @map("is_active")
  capacity     Decimal? @db.Decimal(14, 2)
  capacityUnit String?  @map("capacity_unit")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent    WarehouseLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  WarehouseLocation[] @relation("LocationHierarchy")
  documents InventoryDocument[]
  tasks     InventoryTask[]

  @@unique([warehouseId, parentKey, code])
  @@index([warehouseId, level])
  @@index([warehouseId, parentId])
  @@index([warehouseId, path])
  @@index([warehouseId, isActive])
  @@map("warehouse_locations")
}

// ============================================
// INVENTORY — OVERRIDE REQUESTS (PR-INVENTORY-01-S03)
// ============================================

model OverrideRequest {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String    @default("org_001") @map("organization_id")
  action           String
  resourceType     String    @map("resource_type")
  resourceId       String    @map("resource_id") @db.Uuid
  reason           String
  evidenceUrl      String?   @map("evidence_url")
  requestedById    String    @map("requested_by_id") @db.Uuid
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz
  rejectedById     String?   @map("rejected_by_id") @db.Uuid
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason  String?   @map("rejection_reason")
  cancelledById    String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz
  status           String    @default("PENDING")
  executedById     String?   @map("executed_by_id") @db.Uuid
  executedAt       DateTime? @map("executed_at") @db.Timestamptz
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, expiresAt])
  @@index([resourceType, resourceId])
  @@index([organizationId, requestedAt])
  @@map("override_requests")
}

// ============================================
// INVENTORY — DOCUMENTS (PR-INVENTORY-01-S04)
// ============================================

model InventoryDocument {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String    @default("org_001") @map("organization_id")
  warehouseId       String?   @map("warehouse_id") @db.Uuid
  locationId        String?   @map("location_id") @db.Uuid
  documentType      String    @map("document_type")
  fileName          String    @map("file_name")
  fileSize          Int       @map("file_size")
  mimeType          String    @map("mime_type")
  sha256Hash        String    @map("sha256_hash")
  storagePath       String    @map("storage_path")
  version           Int       @default(1)
  previousVersionId String?   @map("previous_version_id") @db.Uuid
  classification    String?
  retentionDays     Int?      @map("retention_days")
  description       String?
  tags              String[]  @default([])
  uploadedById      String    @map("uploaded_by_id") @db.Uuid
  uploadedAt        DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz
  isArchived        Boolean   @default(false) @map("is_archived")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz
  archivedById      String?   @map("archived_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([warehouseId])
  @@index([locationId])
  @@index([sha256Hash])
  @@index([documentType, warehouseId, locationId, version])
  @@index([isArchived])
  @@map("inventory_documents")
}

// ============================================
// INVENTORY — TASKS / SLA / WORKLIST (PR-INVENTORY-01-S06)
// ============================================

model InventoryTask {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String    @default("org_001") @map("organization_id")
  type            String
  title           String
  description     String?
  status          String
  priority        String
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  ownerRole       String?   @map("owner_role")
  dueAt           DateTime? @map("due_at") @db.Timestamptz
  slaMinutes      Int?      @map("sla_minutes")
  sourceType      String    @map("source_type")
  sourceId        String?   @map("source_id") @db.Uuid
  warehouseId     String?   @map("warehouse_id") @db.Uuid
  locationId      String?   @map("location_id") @db.Uuid
  blockedReason   String?   @map("blocked_reason")
  dependencyType  String?   @map("dependency_type")
  dependencyId    String?   @map("dependency_id") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason    String?   @map("cancel_reason")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, priority, dueAt])
  @@index([organizationId, ownerUserId, status])
  @@index([sourceType, sourceId])
  @@index([warehouseId])
  @@index([locationId])
  @@map("inventory_tasks")
}

// ============================================
// INVENTORY — SEGREGATION OF DUTIES (PR-INVENTORY-01-S07)
// ============================================

model SoDRule {
  id                          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId              String   @default("org_001") @map("organization_id")
  code                        String
  name                        String
  description                 String?
  scope                       String?
  action                      String
  resourceType                String   @map("resource_type")
  incompatibleAction          String?  @map("incompatible_action")
  incompatibleRole            String?  @map("incompatible_role")
  incompatiblePermission      String?  @map("incompatible_permission")
  requiresIndependentApproval Boolean  @default(false) @map("requires_independent_approval")
  severity                    String
  status                      String
  version                     Int      @default(1)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, code])
  @@index([organizationId, action, resourceType, status])
  @@map("sod_rules")
}

model SoDViolation {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String    @default("org_001") @map("organization_id")
  ruleId           String    @map("rule_id") @db.Uuid
  ruleCode         String    @map("rule_code")
  actorUserId      String    @map("actor_user_id") @db.Uuid
  action           String
  resourceType     String    @map("resource_type")
  resourceId       String    @map("resource_id") @db.Uuid
  result           String
  status           String
  resolution       String?
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, actorUserId, status])
  @@index([organizationId, resourceType, resourceId])
  @@map("sod_violations")
}

model SoDException {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String    @default("org_001") @map("organization_id")
  violationId       String    @map("violation_id") @db.Uuid
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  reason            String
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  status            String
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  approvedReason    String?   @map("approved_reason")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz
  rejectedByUserId  String?   @map("rejected_by_user_id") @db.Uuid
  rejectedReason    String?   @map("rejected_reason")
  rejectedAt        DateTime? @map("rejected_at") @db.Timestamptz
  revokedByUserId   String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason     String?   @map("revoked_reason")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, violationId, status])
  @@index([organizationId, requestedByUserId])
  @@map("sod_exceptions")
}

// ============================================
// INVENTORY — EVENT OUTBOX (PR-INVENTORY-01-S08)
// ============================================

model InventoryEventOutbox {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String    @default("org_001") @map("organization_id")
  eventType        String    @map("event_type")
  eventVersion     Int       @map("event_version")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  producer         String
  payload          Json
  status           String
  correlationId    String    @map("correlation_id")
  idempotencyKey   String?   @unique @map("idempotency_key")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz
  availableAt      DateTime? @map("available_at") @db.Timestamptz
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz
  failedAt         DateTime? @map("failed_at") @db.Timestamptz
  retryCount       Int       @default(0) @map("retry_count")
  lastErrorCode    String?   @map("last_error_code")
  lastErrorMessage String?   @map("last_error_message")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, status, occurredAt])
  @@index([eventType, eventVersion])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("inventory_event_outbox")
}
