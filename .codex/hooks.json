{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_secrets.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_secrets.py\"",
            "statusMessage": "Checking prompt for secrets",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_dangerous_commands.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_dangerous_commands.py\"",
            "statusMessage": "Checking command against repository policy",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_context.py\"",
            "statusMessage": "Loading Sunset ERP agent context",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_context.py\"",
            "statusMessage": "Applying Sunset ERP subagent policy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
