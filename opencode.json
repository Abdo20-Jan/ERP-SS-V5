{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "{env:OPENCODE_MODEL_ORCHESTRATOR}",
  "small_model": "{env:OPENCODE_MODEL_FAST}",
  "subagent_depth": 1,
  "share": "disabled",
  "autoupdate": "notify",
  "formatter": true,
  "lsp": true,
  "instructions": [
    "AGENTS.md",
    "docs/AGENTS.md",
    "docs/agents/00_AGENT_SYSTEM_OVERVIEW.md",
    "docs/agents/01_AGENT_ROUTING_MATRIX.md",
    "docs/agents/02_HANDOFF_PROTOCOL.md",
    "docs/agents/03_EVIDENCE_AND_SOURCE_POLICY.md",
    "docs/agents/SOURCE_BASIS.md",
    "docs/governance/DECISION_PRECEDENCE.md",
    "docs/execution/MEMORY_PROTOCOL.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".turbo/**",
      "dist/**",
      "coverage/**",
      "target/**",
      "docs/blueprint-accepted/**",
      "docs/reference-inputs/**",
      "**/*.png",
      "**/*.webp",
      "**/*.pdf",
      "FILE_MANIFEST_SHA256.csv",
      ".opencode-runs/**",
      ".setup-backups/**",
      "**/.DS_Store",
      "__MACOSX/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/auth.json": "deny",
      "**/*credentials*": "deny",
      "**/*secret*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "ask",
    "task": "ask",
    "edit": {
      "*": "ask",
      "/Users/abdochamseddine/Documents/ERP-OPENCODE-VAULT/**": "allow"
    },
    "external_directory": {
      "*": "deny",
      "/Users/abdochamseddine/Documents/ERP-OPENCODE-VAULT/**": "allow"
    },
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "python3 scripts/doctor.py*": "allow",
      "python3 scripts/validate-*": "allow",
      "git push*": "deny",
      "gh pr merge*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "railway up*": "deny",
      "vercel --prod*": "deny",
      "kubectl apply*": "deny",
      "kubectl delete*": "deny"
    }
  },
  "agent": {
